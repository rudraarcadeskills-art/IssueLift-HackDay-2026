# IssueLift Environment Variables (Template)
# Copy this file to .env.local to configure your local development environment.
# NEVER commit .env.local or expose secrets to git.

# Google Gemini API Key for Gemma 4 (Free tier available at aistudio.google.com/apikey)
# Standardized as server-side secret only. NEVER prefix with NEXT_PUBLIC_.
GEMMA_API_KEY=your_gemma_api_key_here

# Verified Gemma 4 model ID (Default: gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: GitHub Personal Access Token (for higher public REST rate limits)
# Leave blank to use unauthenticated public requests (up to 60 req/hr per IP)
GITHUB_TOKEN=

# Node Environment
NODE_ENV=development
